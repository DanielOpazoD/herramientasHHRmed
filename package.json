{
  "name": "herramientas-hhr-med",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Herramientas clínicas HHR modulares, locales y reutilizables.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test packages/insulin-core/test/*.test.js",
    "test:types": "tsc -p tsconfig.types.json",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run test && npm run test:types && npm run build && npm run format:check"
  },
  "devDependencies": {
    "esbuild": "0.27.2",
    "prettier": "3.8.1",
    "@playwright/test": "1.57.0",
    "typescript": "5.8.3",
    "@types/node": "22.19.3"
  }
}
